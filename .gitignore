/reports/
/directives/
R-[0-9]*.md
D-[0-9]*.md

# Local scratch / notes
/scratch/
/notes/
*.local
*.local.*

# Desktop build outputs (installers publish to GitHub Releases, never committed)
/node_modules/
/www/
/dist/
package-lock.json

# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini
*~
.vscode/
.idea/
